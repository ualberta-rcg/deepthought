{
  "listen_addr": "0.0.0.0:8080",
  "session_ttl_hours": 24,
  "admin_users": [
    "rahimk"
  ],
  "auth": {
    "mode": "password",
    "oidc": {
      "enabled": false,
      "issuer": "https://idp.alliancecan.ca",
      "metadata_url": "https://idp.alliancecan.ca/.well-known/openid-configuration",
      "client_id": "deepthought.vulcan.alliancecan.ca",
      "client_secret_env": "DEEPTHOUGHT_OIDC_CLIENT_SECRET",
      "redirect_uri": "https://deepthought.vulcan.alliancecan.ca/oidc",
      "scopes": [
        "openid",
        "profile",
        "email"
      ],
      "remote_user_claim": "preferred_username",
      "email_claim": "email",
      "groups_claim": "groups",
      "allowed_groups": [],
      "trust_proxy_headers": false,
      "proxy_user_header": "OIDC_CLAIM_preferred_username",
      "proxy_email_header": "OIDC_CLAIM_email",
      "post_login_hook": "/opt/ood/scripts/ood_pun_oidc_email.sh",
      "post_login_hook_exports": [
        "OIDC_CLAIM_email"
      ]
    }
  }
}
