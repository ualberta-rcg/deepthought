{
  "listen_addr": "0.0.0.0:8080",
  "session_ttl_hours": 24,
  "admin_users": [
    "admin"
  ],
  "auth": {
    "mode": "password",
    "oidc": {
      "enabled": false,
      "issuer": "https://idp.example.org",
      "metadata_url": "https://idp.example.org/.well-known/openid-configuration",
      "client_id": "deepthought.example.org",
      "client_secret_env": "DEEPTHOUGHT_OIDC_CLIENT_SECRET",
      "redirect_uri": "https://deepthought.example.org/oidc",
      "scopes": [
        "openid",
        "profile",
        "email"
      ],
      "remote_user_claim": "preferred_username",
      "first_name_claim": "given_name",
      "last_name_claim": "family_name",
      "email_claim": "email",
      "uid_claim": "uidNumber",
      "trust_proxy_headers": false,
      "proxy_user_header": "OIDC_CLAIM_preferred_username",
      "proxy_email_header": "OIDC_CLAIM_email",
      "post_login_hook": "",
      "post_login_hook_exports": [
        "OIDC_CLAIM_email"
      ]
    }
  }
}
